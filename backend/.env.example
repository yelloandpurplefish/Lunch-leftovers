# 伺服器配置
PORT=3000
NODE_ENV=development

# JWT 簽章密鑰（請使用隨機產生的長字串，至少 32 字元）
JWT_SECRET=your-random-jwt-secret-min-32-characters

# Firebase Service Account Key
# 選項 1：環境變數（適用於 Render 等雲端部署）
# 將 Service Account Key JSON 壓成單行字串貼在這裡
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"lunch-leftovers",...}
#
# 選項 2：檔案（適用於本地開發）
# 將 service-account-key.json 放在 backend/ 目錄下
#
# 取得方式：Firebase Console > 專案設定 > 服務帳戶 > 產生新的私密金鑰

# CORS 允許來源（逗號分隔，未設定時依 NODE_ENV 使用預設值）
# CORS_ORIGINS=https://lunch-leftovers.onrender.com

# ============================================================
# 資料庫初始化
# ============================================================
# 基礎資料（reward_items / system_config / daily_menu）會在每次啟動時
# 自動以 merge 方式寫入，無需額外設定。

# 是否自動建立開發/測試帳號（預設 false）
# SEED_TEST_ACCOUNTS=true

# 測試帳號共用密碼，至少 12 字元。
# 未設定時不會建立任何測試帳號。
# TEST_USER_PASSWORD=

# 生產環境建立測試帳號需額外確認（強烈不建議）
# ALLOW_PRODUCTION_TEST_ACCOUNTS=true