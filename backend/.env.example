# 伺服器配置
PORT=3000
NODE_ENV=development

# JWT 簽章密鑰（請使用隨機產生的長字串，至少 32 字元）
JWT_SECRET=your-random-jwt-secret-min-32-characters

# Firebase Service Account Key
# 選項 1：環境變數（適用於 Render 等雲端部署）
# 將 Service Account Key JSON 壓成單行字串貼在這裡
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"lunch-leftovers",...}
#
# 選項 2：檔案（適用於本地開發）
# 將 service-account-key.json 放在 backend/ 目錄下
#
# 取得方式：Firebase Console > 專案設定 > 服務帳戶 > 產生新的私密金鑰

# CORS 允許來源（逗號分隔，未設定時依 NODE_ENV 使用預設值）
# CORS_ORIGINS=https://lunch-leftovers.onrender.com

# ============================================================
# 資料庫初始化
# ============================================================
# 基礎資料（reward_items / system_config / daily_menu）會在每次啟動時
# 自動以 merge 方式寫入，無需額外設定。

# 是否自動建立開發/測試帳號（預設 false）
# SEED_TEST_ACCOUNTS=true

# 測試帳號共用密碼，至少 12 字元。
# 未設定時不會建立任何測試帳號。
# TEST_USER_PASSWORD=

# 額外批次建立測試學生帳號數量（0 或不設定表示不建立）
# EXTRA_TEST_ACCOUNTS=5

# 生產環境建立測試帳號需額外確認（強烈不建議）
# ALLOW_PRODUCTION_TEST_ACCOUNTS=true

# ============================================================
# 本機開發：Firestore Emulator（新增）
# ============================================================
# 設了這個就不需要任何服務帳戶金鑰，資料存在記憶體、重啟即清空。
# 另開視窗執行：npx firebase emulators:start --only firestore --project lunch-leftovers-dev
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# GCLOUD_PROJECT=lunch-leftovers-dev

# ============================================================
# 影像辨識服務 vision_service（新增）
# ============================================================
# 四桶剩食紀錄會呼叫這個服務；未設定或未啟動時會退回預設估算，
# 並要求午餐長自行確認殘餘比例，流程不會中斷。
# 啟動：cd ../../vision_service && python app.py
# VISION_API_BASE=http://127.0.0.1:5001
# VISION_TIMEOUT_MS=30000
# 辨識服務若可被外部連到，兩邊需設同一組密鑰
# VISION_TOKEN=

# 上傳照片的 JSON 大小上限（預設 8mb；照片 base64 會膨脹約 1.37 倍）
# JSON_BODY_LIMIT=8mb

# ── 學生名冊同步（Google 試算表 → Firestore）──────────────────
# 部署 google-apps-script/sync-students.gs 之後取得的網頁應用程式網址，
# 以及與其指令碼屬性 SYNC_TOKEN 相同的密鑰。
# 兩者都沒設定時，管理員面板的同步按鈕會回報「尚未設定試算表來源」。
STUDENT_SHEET_URL=
STUDENT_SHEET_TOKEN=
# 選填：逾時與單次上限
STUDENT_SHEET_TIMEOUT_MS=20000
STUDENT_SHEET_MAX_ROWS=2000

# ── 每月菜單同步（Google 試算表 → daily_menu）────────────────
# 與學生名冊分開部署：菜單多半由營養師維護，不該連帶拿到學生個資。
MENU_SHEET_URL=
MENU_SHEET_TOKEN=
MENU_SHEET_TIMEOUT_MS=20000
MENU_SHEET_MAX_ROWS=400
