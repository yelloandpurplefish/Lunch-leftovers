# 伺服器配置
PORT=3000
NODE_ENV=development

# Firebase Admin SDK 配置
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com

# Firebase Service Account Key (選項1：環境變數)
# 將 Firebase Service Account Key JSON 轉換為單行字符串並設置為環境變數
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...",...}

# 或者選項2：使用文件 (本地開發)
# 將 service-account-key.json 文件放在 backend/ 目錄下
# 請參考 FIREBASE_SETUP.md 了解如何獲取 Service Account Key